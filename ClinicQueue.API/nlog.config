<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      throwConfigExceptions="true">

  <extensions>
    <add assembly="NLog.Web.AspNetCore" />
  </extensions>

  <variable name="layout"
            value="${longdate}|${level:uppercase=true}|${scopeproperty:CorrelationId}|${logger:shortName=true}|${message}${onexception:inner=${newline}${exception:format=tostring}}" />

  <targets>
    <!-- קובץ (נשמר ב-logs/ ולא נכנס ל-Git) + קונסול (ב-Render קוראים את הלוגים מהקונסול) -->
    <target xsi:type="File" name="file" fileName="logs/clinicqueue-${shortdate}.log"
            layout="${layout}" encoding="utf-8" keepFileOpen="false" maxArchiveDays="14" />
    <target xsi:type="Console" name="console" layout="${layout}" />
  </targets>

  <rules>
    <!-- רעשי framework (EF, ASP.NET) רק מאזהרה ומעלה; הקוד שלנו מ-Debug, והרמה בפועל נקבעת ב-appsettings -->
    <logger name="Microsoft.*" maxlevel="Info" final="true" />
    <logger name="System.*" maxlevel="Info" final="true" />
    <logger name="*" minlevel="Debug" writeTo="file,console" />
  </rules>
</nlog>
